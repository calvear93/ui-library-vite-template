{
	"$schema": "https://json.schemastore.org/package.json",
	"version": "0.0.1",
	"name": "(((lib-name)))",
	"description": "(((description)))",
	"repository": "(((repository)))",
	"license": "MIT",
	"keywords": [
		"react",
		"vite",
		"vitest",
		"typescript",
		"storybook",
		"ui",
		"component-library",
		"design-system",
		"unocss"
	],
	"scripts": {
		"dev": "storybook dev -p 5001",
		"build": "vite build",
		"build:storybook": "storybook build",
		"test": "vitest",
		"test:cov": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
		"stylelint": "stylelint --cache src/**/*.css --cache-location node_modules/.cache/stylelint/",
		"format": "prettier --cache --write **/*.{ts,mts,tsx,css,json,html,md,yml,yaml,webmanifest}",
		"clean": "pnpx del-cli dist .reports storybook-static **/*.tsbuildinfo",
		"pub": "pnpm typecheck && pnpm lint && pnpm test:cov && pnpm build && pnpm publish dist --access public --no-git-checks",
		"pub:alpha": "pnpm typecheck && pnpm lint && pnpm test:cov && pnpm build && pnpm publish dist --tag alpha --access public --no-git-checks"
	},
	"imports": {
		"#testing": "./src/__tests__/index.ts"
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"@iconify-json/mdi": "1.2.3",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.6",
		"@storybook/addon-links": "10.6.6",
		"@storybook/addon-onboarding": "10.6.6",
		"@storybook/react-vite": "10.6.6",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/eslint": "9.6.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@unocss/eslint-config": "66.12.0",
		"@vitejs/plugin-react": "6.2.1",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.28",
		"@whitespace/storybook-addon-html": "9.0.0",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jest-dom": "5.10.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-sonarjs": "4.2.2",
		"eslint-plugin-storybook": "10.6.6",
		"eslint-plugin-testing-library": "7.16.2",
		"eslint-plugin-unicorn": "79.0.0",
		"glob": "14.0.3",
		"globals": "17.14.0",
		"happy-dom": "21.0.4",
		"postcss": "8.5.32",
		"prettier": "3.9.10",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"storybook": "10.6.6",
		"storybook-dark-mode": "5.0.0",
		"stylelint": "18.0.0",
		"stylelint-config-recommended": "19.0.0",
		"stylelint-config-standard": "41.0.0",
		"stylelint-order": "8.1.3",
		"stylelint-use-nesting": "6.0.2",
		"tslib": "2.9.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"unocss": "66.12.0",
		"vite": "8.3.6",
		"vite-plugin-checker": "0.14.5",
		"vite-plugin-dts": "5.1.2",
		"vite-plugin-lib-inject-css": "2.2.2",
		"vitest": "5.1.0",
		"vitest-mock-extended": "5.1.1"
	},
	"type": "module",
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"packageManager": "pnpm@12.18.0"
}
